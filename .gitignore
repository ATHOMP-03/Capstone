# ── Raw data (Bloomberg exports — never commit) ───────────────────────────────
data/raw/

# ── Processed CSVs (large; regenerated by clean_data*.py) ────────────────────
data/processed/*.csv

# ── References (PDFs, working docs) ──────────────────────────────────────────
references/

# ── Python build artifacts ────────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/

# ── R artifacts (R removed; these are safety catches) ────────────────────────
.Rhistory
.RData

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
.vscode/

# ── Binary presentation files (track in Overleaf/Drive instead) ──────────────
output/*.pptx
output/*.docx

# ── LaTeX build artifacts ─────────────────────────────────────────────────────
*.log
*.aux
*.out
*.toc
*.synctex.gz
